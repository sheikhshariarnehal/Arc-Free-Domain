// ARC.BD Environment Variables Template
// Copy this file to .env.local and fill in your values

// ============================================================
// Supabase Configuration
// ============================================================
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

// Server-side only — NEVER expose to browser
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

// ============================================================
// Cloudflare DNS Configuration
// ============================================================
// Server-side only — NEVER expose to browser
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_ZONE_ID=your_cloudflare_zone_id

// ============================================================
// Application Configuration
// ============================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DOMAIN=arc.bd

// ============================================================
// Transactional Email Configuration
// Choose Option A (Resend) OR Option B (Standard SMTP / Gmail / Brevo)
// ============================================================

// Option A: Resend API
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=ARC.BD <noreply@arc.bd>

// Option B: Standard SMTP (e.g. Gmail / Brevo / Mailgun / AWS SES)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=ARC.BD <your_email@gmail.com>
